<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"

       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"

       xsi:schemaLocation="http://www.springframework.org/schema/beans
http://www.springframework.org/schema/beans/spring-beans.xsd http://www.springframework.org/schema/context https://www.springframework.org/schema/context/spring-context.xsd">
    <bean id = "Lib1" class= "dependency_injection.Library1">
        <property name="id" value = "101"></property>
        <property name="name" value = "friends"></property>
        <property name="books">
            <list>
                <ref bean = "B1"/>
                <ref bean = "B2"/>
            </list>
        </property>
    </bean>
    <bean id ="B1" class = "dependency_injection.Book">
        <property name="bookid" value = "1"> </property>
        <property name = "bookName" value = "Wings"></property>
    </bean>
    <bean id ="B2" class = "dependency_injection.Book">
        <property name="bookid" value = "2"> </property>
        <property name = "bookName" value = "2States"></property>
    </bean>
</beans>